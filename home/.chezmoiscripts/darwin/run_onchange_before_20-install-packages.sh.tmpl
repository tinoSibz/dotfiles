{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env zsh
set -euo pipefail

if (( ! $+commands[brew] )); then
    print -u2 "brew is not installed; skipping"
    exit 0
fi

# Write Brewfile to temp file so we can run both install and cleanup
BREWFILE=$(mktemp)
trap "rm -f $BREWFILE" EXIT

cat > "$BREWFILE" <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

# Install packages
brew bundle install --file="$BREWFILE"

# Remove packages not in Brewfile
brew bundle cleanup --force --file="$BREWFILE"

# Remove unused dependencies
brew autoremove

# Remove old cached downloads and old versions
brew cleanup --prune=all

{{- else }}
exit 0
{{- end }}
