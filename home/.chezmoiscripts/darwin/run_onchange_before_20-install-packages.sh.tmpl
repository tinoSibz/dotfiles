{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env zsh
set -euo pipefail

if (( ! $+commands[brew] )); then
    print -u2 "brew is not installed; skipping"
    exit 0
fi

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{- else }}
exit 0
{{- end }}
